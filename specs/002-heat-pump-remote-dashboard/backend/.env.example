# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/heat_pump_dashboard?schema=public"

# Session & Security
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_EXPIRE_HOURS=8
COOKIE_SECRET=heat-pump-dashboard-secret

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=heat-pump-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1

# Redis (Optional - for session storage)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Safety Thresholds
MAX_FAILED_LOGIN_ATTEMPTS=3
RATE_LIMIT_CONTROL_SECONDS=10
DATA_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=7
DEVICE_OFFLINE_THRESHOLD_SECONDS=30
